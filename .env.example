NORTHGATE_MASTER_KEY=replace-with-32-byte-base64
NORTHGATE_ADMIN_TOKEN=replace-with-random-admin-token
NORTHGATE_GATEWAY_KEY=replace-with-random-gateway-key
NORTHGATE_BIND=127.0.0.1:8787
NORTHGATE_DATABASE_PATH=data/northgate.db
NORTHGATE_MAX_UPSTREAM_CONCURRENCY=32
NORTHGATE_MAX_INBOUND_CONCURRENCY=64
# Maximum wait for provider response headers/first streamed event (1-900 seconds).
NORTHGATE_FIRST_BYTE_TIMEOUT_SECS=300
# 0 disables application-level stream idle timeout; transport failures still close streams.
NORTHGATE_STREAM_IDLE_TIMEOUT_SECS=0
# Enable only when deliberately connecting to localhost/private-network providers.
NORTHGATE_ALLOW_PRIVATE_UPSTREAMS=false
